# Bu dosyayı .env.local olarak kopyalayıp değerleri doldurun.
# PostgreSQL bağlantı adresi
DATABASE_URL="postgresql://KULLANICI:SIFRE@SUNUCU:5432/gazetelerde"
# İlk yönetici hesabı (npm run db:seed ile oluşturulur)
ADMIN_EMAIL=admin@gazetelerde.com
ADMIN_PASSWORD=
# Sitenin herkese açık adresi (OpenGraph linkleri için)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Görsel optimizasyonuna izin verilen alan adları (virgülle). Listede olmayanlar optimize edilmeden gösterilir.
NEXT_PUBLIC_IMAGE_HOSTS=images.unsplash.com

# Künye / KVKK / İletişim sayfalarında görünen kurum bilgileri (doldurulmayanlar sayfada [ ... ] olarak görünür)
COMPANY_TITLE=
COMPANY_ADDRESS=
COMPANY_TAX=
COMPANY_PUBLISHER=
COMPANY_EDITOR=
CONTACT_EMAIL=
CONTACT_PHONE=
KVKK_EMAIL=
HOSTING_PROVIDER=

# --- E-posta / bülten ---
# SMTP bağlantısı (Resend, Brevo, Amazon SES, Mailgun…). Boşsa geliştirmede e-postalar .mail-outbox klasörüne yazılır,
# canlıda gönderim kapalı kalır.
SMTP_URL=""            # örn. smtps://kullanici:sifre@smtp.saglayici.com:465
MAIL_FROM=""           # örn. "Gazetelerde <bulten@alanadiniz.com>" (alan adı SPF/DKIM ile doğrulanmış olmalı)
MAIL_RATE_PER_MINUTE=60
# Otomatik sabah bülteni: off | draft (taslak hazırlar) | send (doğrudan gönderir)
NEWSLETTER_AUTO=off
NEWSLETTER_DAILY_AT=08:00
