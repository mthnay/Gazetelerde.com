# Bu dosyayı .env.local olarak kopyalayıp değerleri doldurun.
# Oturum çerezlerini imzalamak için uzun, rastgele bir değer (ör. `openssl rand -base64 32`)
AUTH_SECRET=
# Yönetici girişi
ADMIN_EMAIL=admin@gazetelerde.com
ADMIN_PASSWORD=
# Sitenin herkese açık adresi (OpenGraph linkleri için)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
