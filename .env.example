# Bu dosyayı .env.local olarak kopyalayıp değerleri doldurun.
# PostgreSQL bağlantı adresi
DATABASE_URL="postgresql://KULLANICI:SIFRE@SUNUCU:5432/gazetelerde"
# İlk yönetici hesabı (npm run db:seed ile oluşturulur)
ADMIN_EMAIL=admin@gazetelerde.com
ADMIN_PASSWORD=
# Sitenin herkese açık adresi (OpenGraph linkleri için)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Görsel optimizasyonuna izin verilen alan adları (virgülle). Listede olmayanlar optimize edilmeden gösterilir.
NEXT_PUBLIC_IMAGE_HOSTS=images.unsplash.com

# Künye / KVKK / İletişim sayfalarında görünen kurum bilgileri (doldurulmayanlar sayfada [ ... ] olarak görünür)
COMPANY_TITLE=
COMPANY_ADDRESS=
COMPANY_TAX=
COMPANY_PUBLISHER=
COMPANY_EDITOR=
CONTACT_EMAIL=
CONTACT_PHONE=
KVKK_EMAIL=
HOSTING_PROVIDER=

# --- E-posta / bülten ---
# SMTP bağlantısı (Resend, Brevo, Amazon SES, Mailgun…). Boşsa geliştirmede e-postalar .mail-outbox klasörüne yazılır,
# canlıda gönderim kapalı kalır.
SMTP_URL=""            # örn. smtps://kullanici:sifre@smtp.saglayici.com:465
MAIL_FROM=""           # örn. "Gazetelerde <bulten@alanadiniz.com>" (alan adı SPF/DKIM ile doğrulanmış olmalı)
MAIL_RATE_PER_MINUTE=60
# Otomatik sabah bülteni: off | draft (taslak hazırlar) | send (doğrudan gönderir)
NEWSLETTER_AUTO=off
NEWSLETTER_DAILY_AT=08:00

# --- Web push bildirimleri ---  (anahtar üretmek için: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:iletisim@alanadiniz.com"

# --- Güvenlik ---
# Oturum dışı gizli anahtar: 2FA anahtarlarını şifreler, IP özetlerini tuzlar. Değiştirilirse açık 2FA'lar çalışmaz.
# Üretmek için: openssl rand -base64 48
# AUTH_SECRET=""   (yukarıda tanımlıysa tekrar yazmayın)

# --- Arama motorları ---
GOOGLE_SITE_VERIFICATION=""   # Search Console > HTML etiketi yöntemindeki content değeri
BING_SITE_VERIFICATION=""

# --- Yapay zekâ editör yardımcısı ---
# Biri yeterli; ikisi de varsa Gemini kullanılır (AI_PROVIDER=gemini|claude ile değiştirilebilir). Boşsa kapalı.
GEMINI_API_KEY=""        # https://aistudio.google.com/apikey
GEMINI_MODEL=""          # boşsa gemini-3.8-flash
GEMINI_FALLBACK_MODEL="" # ana model yoğunken ya da yanıt vermezken; boşsa gemini-3.5-flash
GEMINI_TIMEOUT_MS=""     # ana model bu kadar ms içinde yanıt vermezse yedeğe geçilir (varsayılan 40000)
ANTHROPIC_API_KEY=""     # https://console.anthropic.com
AI_PROVIDER=

# Her pazartesi 08:00'de "Haftanın voleybol özeti" bülten taslağı hazırlanır (editör gönderir). Kapatmak için: off
NEWSLETTER_VOLLEY=""

# --- Otomatik haber akışı (README → Otomatik haber akışı) ---
INGEST_SECRET=""            # POST /api/ingest/articles anahtarı (en az 16 karakter; boşsa kapalı)
INGEST_DEFAULT_STATUS="REVIEW"  # DRAFT | REVIEW | PUBLISH
FEED_POLL_MINUTES="30"      # kaynak tarama sıklığı (0 = kapalı)
FEED_AUTO_PER_RUN="8"       # tarama başına kaynak başına en fazla haber
FEED_BREAKING_HOURS="24"     # akış haberi kaç saat son dakika şeridinde kalır
FEED_PUSH="1"               # 0 = akış son dakikaları için telefon bildirimi gönderme
FEED_PUSH_PER_HOUR="4"      # akış bildirimleri için saatlik üst sınır
FEATURED_HOURS="48"         # manşet işareti bu kadar saat sonra kalkar (0 = kalkmaz)
MANUAL_ARCHIVE_DAYS="0"     # elle yazılan haberler bu kadar gün sonra kalıcı silinir (0 = silinmez)
MOST_READ_DAYS="3"          # "Çok Okunanlar" son kaç günün haberlerinden seçilir
FEED_UPDATE_HOURS="48"      # kaynakta değişen haber bu kadar saat takip edilip güncellenir (0 = kapalı)
FEED_UPDATE_PER_RUN="5"     # tarama başına kaynak başına yeniden kontrol edilecek haber
AUTO_AUTHOR_NAME="Gazetelerde Spor"
