{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-c",
        "PATH=/opt/homebrew/opt/node@22/bin:$PATH npm run dev"
      ],
      "port": 3000
    },
    {
      "name": "prod",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-c",
        "PATH=/opt/homebrew/opt/node@22/bin:$PATH npx next start -p 3001"
      ],
      "port": 3001
    }
  ]
}