generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  READER
  AUTHOR
  EDITOR
  ADMIN
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CommentStatus {
  VISIBLE
  HIDDEN
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(READER)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  // Bildirim zilinin en son açıldığı an; bundan sonra çıkan haberler "yeni" sayılır
  notificationsSeenAt DateTime @default(now()) @db.Timestamptz(3)

  sessions    Session[]
  articles    Article[]
  comments    Comment[]
  likes       Like[]
  bookmarks   Bookmark[]
  follows     CategoryFollow[]
  reports     CommentReport[]
  media       Media[]
  revisions   ArticleRevision[]
  templates   ArticleTemplate[]
  newsletters NewsletterIssue[]
}

model Session {
  id        String   @id // rastgele token'ın SHA-256 özeti
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
}

model Category {
  id          Int              @id @default(autoincrement())
  slug        String           @unique
  label       String
  description String           @default("")
  sortOrder   Int              @default(0)
  articles    Article[]
  followers   CategoryFollow[]
  feeds       FeedSource[]
}

model Article {
  id          Int           @id @default(autoincrement())
  slug        String        @unique
  title       String
  summary     String
  content     String // paragraflar boş satırla ayrılır
  image       String?
  status      ArticleStatus @default(DRAFT)
  featured    Boolean       @default(false)
  breaking    Boolean       @default(false) // son dakika şeridinde gösterilir
  viewCount   Int           @default(0)
  publishedAt DateTime?     @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String? // kullanıcı hesabı olmayan yazarlar / ajanslar için

  comments   Comment[]
  tags       ArticleTag[]
  dailyStats ArticleDailyStat[]
  likes      Like[]
  bookmarks  Bookmark[]
  revisions  ArticleRevision[]
  feedItem   FeedItem?

  // İçerik dışarıdan alındıysa (RSS / link) kaynağı
  sourceUrl String?

  // Haber sayfasının düzeni: { hero, width, aside, dropcap } (bkz. lib/layout.js)
  layout Json?

  @@index([status, publishedAt])
  @@index([categoryId, status, publishedAt])
}

model Comment {
  id        Int           @id @default(autoincrement())
  text      String
  status    CommentStatus @default(VISIBLE)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)

  articleId Int
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Cevaplar tek seviyelidir: cevabın cevabı, ana yoruma bağlanır
  parentId Int?
  parent   Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("Replies")

  reports     CommentReport[]
  reportCount Int             @default(0)

  @@index([articleId, createdAt])
  @@index([parentId])
}

model CommentReport {
  commentId Int
  userId    String
  reason    String   @default("")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
}

model CategoryFollow {
  userId     String
  categoryId Int
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@index([categoryId])
}

model Subscriber {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  token          String    @unique // onay ve abonelikten çıkma linkleri için
  active         Boolean   @default(true)
  // Çift onay: e-postadaki bağlantıya tıklanana kadar bülten gönderilmez
  confirmedAt    DateTime? @db.Timestamptz(3)
  unsubscribedAt DateTime? @db.Timestamptz(3)
  confirmSentAt  DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  deliveries NewsletterDelivery[]

  @@index([active, confirmedAt])
}

enum NewsletterStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

model NewsletterIssue {
  id          Int              @id @default(autoincrement())
  subject     String
  preheader   String           @default("") // e-posta listesinde konunun yanında görünen kısa metin
  intro       String           @default("")
  articleIds  Int[] // sıralı haber listesi
  status      NewsletterStatus @default(DRAFT)
  auto        Boolean          @default(false) // sabah bülteni otomatik oluşturduysa
  scheduledAt DateTime?        @db.Timestamptz(3)
  startedAt   DateTime?        @db.Timestamptz(3)
  sentAt      DateTime?        @db.Timestamptz(3)
  recipients  Int              @default(0)
  sentCount   Int              @default(0)
  failedCount Int              @default(0)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  createdById String?
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  deliveries NewsletterDelivery[]

  @@index([status, scheduledAt])
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

// Her abone için tek kayıt: gönderim yarıda kesilirse kaldığı yerden devam eder, kimseye iki kez gitmez
model NewsletterDelivery {
  issueId      Int
  subscriberId Int
  status       DeliveryStatus  @default(PENDING)
  attempts     Int             @default(0)
  error        String?
  sentAt       DateTime?       @db.Timestamptz(3)
  issue        NewsletterIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  subscriber   Subscriber      @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@id([issueId, subscriberId])
  @@index([issueId, status])
}

model Like {
  userId    String
  articleId Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([articleId])
}

model Bookmark {
  userId    String
  articleId Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([articleId])
}

// Yüklenen görseller veritabanında tutulur (yedeklemeyle birlikte gelir, ek depolama gerektirmez).
// Yüklemede WebP'ye çevrilip en fazla 2000 px'e küçültülür.
model Media {
  id           String   @id @default(cuid())
  mime         String
  width        Int
  height       Int
  bytes        Bytes
  size         Int
  alt          String   @default("")
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

enum RevisionKind {
  SAVE // editör "Kaydet"e bastı
  AUTOSAVE // otomatik kayıt (yayındaki haberi değiştirmez)
  RESTORE // eski sürüm geri yüklendi
}

model ArticleRevision {
  id        Int          @id @default(autoincrement())
  kind      RevisionKind
  title     String
  summary   String
  content   String
  image     String?
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  articleId Int
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([articleId, createdAt])
}

model FeedSource {
  id            Int       @id @default(autoincrement())
  name          String
  url           String    @unique
  active        Boolean   @default(true)
  lastFetchedAt DateTime? @db.Timestamptz(3)
  lastError     String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  // Bu kaynaktan gelen taslaklar varsayılan olarak bu kategoriye düşer
  categoryId Int?
  category   Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items      FeedItem[]
}

enum FeedItemStatus {
  NEW
  DRAFTED
  IGNORED
}

model FeedItem {
  id          Int            @id @default(autoincrement())
  guid        String
  title       String
  link        String
  summary     String         @default("")
  image       String?
  publishedAt DateTime?      @db.Timestamptz(3)
  status      FeedItemStatus @default(NEW)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)

  sourceId  Int
  source    FeedSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  articleId Int?       @unique
  article   Article?   @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@unique([sourceId, guid])
  @@index([status, createdAt])
}

// Editörde "Şablon olarak kaydet" ile oluşturulan, ekipçe kullanılabilen haber şablonları
model ArticleTemplate {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @default("")
  content     String
  layout      Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------- Etiketler / konu sayfaları
model Tag {
  id          Int          @id @default(autoincrement())
  slug        String       @unique
  name        String
  description String       @default("")
  featured    Boolean      @default(false) // menüde / ana sayfada öne çıkan konu
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  articles    ArticleTag[]
}

model ArticleTag {
  articleId Int
  tagId     Int
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

// ---------------------------------------------------------------- İstatistik (çerezsiz, kişisel veri tutulmaz)
// Günlük toplamlar: tek tek ziyaret değil, gün + haber başına sayaç
model ArticleDailyStat {
  articleId Int
  day       DateTime @db.Date
  views     Int      @default(0)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([articleId, day])
  @@index([day])
}

// Gün + yol türü + kaynak başına sayfa görüntüleme (kaynak: google, facebook, bulten, dogrudan…)
model PageDailyStat {
  day    DateTime @db.Date
  kind   String // haber | kategori | anasayfa | etiket | diger
  source String
  device String // mobil | masaustu
  views  Int      @default(0)

  @@id([day, kind, source, device])
}

// ---------------------------------------------------------------- Web push
model PushSubscription {
  id         Int       @id @default(autoincrement())
  endpoint   String    @unique
  p256dh     String
  auth       String
  categories String[] // boşsa tüm son dakika bildirimleri
  failures   Int       @default(0)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastSentAt DateTime? @db.Timestamptz(3)
}

model PushMessage {
  id          Int       @id @default(autoincrement())
  title       String
  body        String
  url         String
  articleId   Int?      @unique // bir haber için en fazla bir kez bildirim
  sent        Int       @default(0)
  failed      Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  sentAt      DateTime? @db.Timestamptz(3) // gönderim başladığında dolar (iki kez gönderilmesin)
  createdById String?
}

// ---------------------------------------------------------------- Hata takibi
// Aynı hata (parmak izi) tek satırda toplanır, sayısı ve son görülme zamanı güncellenir
model ErrorEvent {
  id          Int      @id @default(autoincrement())
  fingerprint String   @unique
  source      String // sunucu | tarayici | is (arka plan)
  message     String
  stack       String   @default("")
  path        String   @default("")
  count       Int      @default(1)
  resolved    Boolean  @default(false)
  firstSeen   DateTime @default(now()) @db.Timestamptz(3)
  lastSeen    DateTime @default(now()) @db.Timestamptz(3)

  @@index([resolved, lastSeen])
}
