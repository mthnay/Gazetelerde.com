generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  READER
  AUTHOR
  EDITOR
  ADMIN
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CommentStatus {
  VISIBLE
  HIDDEN
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(READER)
  createdAt    DateTime @db.Timestamptz(3)  @default(now())
  updatedAt    DateTime @db.Timestamptz(3)  @updatedAt

  // Bildirim zilinin en son açıldığı an; bundan sonra çıkan haberler "yeni" sayılır
  notificationsSeenAt DateTime @db.Timestamptz(3) @default(now())

  sessions  Session[]
  articles  Article[]
  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]
  follows   CategoryFollow[]
  reports   CommentReport[]
}

model Session {
  id        String   @id // rastgele token'ın SHA-256 özeti
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @db.Timestamptz(3) @default(now())

  @@index([userId])
}

model Category {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  label       String
  description String    @default("")
  sortOrder   Int       @default(0)
  articles    Article[]
  followers   CategoryFollow[]
}

model Article {
  id          Int           @id @default(autoincrement())
  slug        String        @unique
  title       String
  summary     String
  content     String        // paragraflar boş satırla ayrılır
  image       String?
  status      ArticleStatus @default(DRAFT)
  featured    Boolean       @default(false)
  breaking    Boolean       @default(false) // son dakika şeridinde gösterilir
  viewCount   Int           @default(0)
  publishedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime @db.Timestamptz(3)      @default(now())
  updatedAt   DateTime @db.Timestamptz(3)      @updatedAt

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String?  // kullanıcı hesabı olmayan yazarlar / ajanslar için

  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]

  @@index([status, publishedAt])
  @@index([categoryId, status, publishedAt])
}

model Comment {
  id        Int           @id @default(autoincrement())
  text      String
  status    CommentStatus @default(VISIBLE)
  createdAt DateTime @db.Timestamptz(3)      @default(now())

  articleId Int
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Cevaplar tek seviyelidir: cevabın cevabı, ana yoruma bağlanır
  parentId Int?
  parent   Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("Replies")

  reports     CommentReport[]
  reportCount Int @default(0)

  @@index([articleId, createdAt])
  @@index([parentId])
}

model CommentReport {
  commentId Int
  userId    String
  reason    String   @default("")
  createdAt DateTime @db.Timestamptz(3) @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
}

model CategoryFollow {
  userId     String
  categoryId Int
  createdAt  DateTime @db.Timestamptz(3) @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@index([categoryId])
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  token     String   @unique // abonelikten çıkma linki için
  active    Boolean  @default(true)
  createdAt DateTime @db.Timestamptz(3) @default(now())
}

model Like {
  userId    String
  articleId Int
  createdAt DateTime @db.Timestamptz(3) @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([articleId])
}

model Bookmark {
  userId    String
  articleId Int
  createdAt DateTime @db.Timestamptz(3) @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([articleId])
}
