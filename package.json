{
  "name": "haberler-core",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "dotenv -e .env.local -- node prisma/seed.mjs",
    "db:studio": "dotenv -e .env.local -- prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cheerio": "^1.1.2",
    "framer-motion": "^12.28.2",
    "lucide-react": "^0.562.0",
    "next": "16.1.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "dotenv-cli": "^11.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "prisma": "^6.19.3"
  }
}
